<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'inter': ['Inter', 'sans-serif'],
          },
          colors: {
            'vet-primary': '#667eea',
            'vet-secondary': '#764ba2',
            'vet-accent': '#f093fb',
            'vet-pink': '#f5576c',
          }
        }
      }
    }
  </script>
</head>
<body class="font-inter bg-gradient-to-br from-vet-primary to-vet-secondary min-h-screen flex items-center justify-center">
  <div class="max-w-md w-full mx-4">
    <!-- Logo and Title -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 bg-white rounded-full mb-4 shadow-lg">
        <i class="fas fa-paw text-vet-primary text-2xl"></i>
      </div>
      <h1 class="text-3xl font-bold text-white mb-2">Patitas Móviles</h1>
      <p class="text-white/80">Iniciar Sesión</p>
    </div>

    <!-- Login Form -->
    <div class="bg-white rounded-2xl shadow-2xl p-8">
      <% if (error) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
          <div class="flex items-center">
            <i class="fas fa-exclamation-circle mr-2"></i>
            <%= error %>
          </div>
        </div>
      <% } %>

      <form action="/auth/login" method="POST" class="space-y-6">
        <div>
          <label for="username" class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-user mr-2 text-vet-primary"></i>
            Usuario
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-200"
            placeholder="Ingresa tu usuario"
          >
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-lock mr-2 text-vet-primary"></i>
            Contraseña
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-200"
            placeholder="Ingresa tu contraseña"
          >
        </div>

        <button
          type="submit"
          class="w-full bg-gradient-to-r from-vet-primary to-vet-secondary text-white font-semibold py-3 px-6 rounded-lg hover:shadow-lg transform hover:-translate-y-0.5 transition-all duration-200"
        >
          <i class="fas fa-sign-in-alt mr-2"></i>
          Iniciar Sesión
        </button>
      </form>

      <% if (process.env.GOOGLE_CLIENT_ID) { %>
        <!-- Divider -->
        <div class="relative my-6">
          <div class="absolute inset-0 flex items-center">
            <div class="w-full border-t border-gray-300"></div>
          </div>
          <div class="relative flex justify-center text-sm">
            <span class="px-2 bg-white text-gray-500">o</span>
          </div>
        </div>

        <!-- Google Login -->
        <a
          href="/auth/google"
          class="w-full flex items-center justify-center px-4 py-3 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors duration-200"
        >
          <svg class="w-5 h-5 mr-3" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Continuar con Google
        </a>
      <% } %>

      <!-- Back to Home -->
      <div class="text-center mt-6">
        <a href="/" class="text-vet-primary hover:text-vet-secondary transition-colors duration-200">
          <i class="fas fa-arrow-left mr-2"></i>
          Volver al inicio
        </a>
      </div>
    </div>

    <!-- Demo Credentials -->
    <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 mt-6 text-white text-sm">
      <h3 class="font-semibold mb-2"><i class="fas fa-info-circle mr-2"></i>Credenciales de prueba:</h3>
      <p><strong>Usuario:</strong> admin</p>
      <p><strong>Contraseña:</strong> admin123</p>
    </div>
  </div>
</body>
</html>
