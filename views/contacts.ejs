<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contactos Registrados - Veterinaria</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <style>
    .contacts-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    
    .contacts-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    
    .contacts-header h1 {
      color: #2c3e50;
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }
    
    .contacts-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    
    .stat-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 1.5rem;
      border-radius: 10px;
      text-align: center;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    
    .stat-card i {
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }
    
    .stat-card h3 {
      font-size: 2rem;
      margin: 0.5rem 0;
    }
    
    .stat-card p {
      margin: 0;
      opacity: 0.9;
    }
    
    .contacts-table {
      background: white;
      border-radius: 10px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      overflow: hidden;
    }
    
    .table-header {
      background: #2c3e50;
      color: white;
      padding: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    
    .search-box {
      display: flex;
      align-items: center;
      background: rgba(255,255,255,0.1);
      border-radius: 5px;
      padding: 0.5rem;
    }
    
    .search-box input {
      background: none;
      border: none;
      color: white;
      padding: 0.5rem;
      outline: none;
    }
    
    .search-box input::placeholder {
      color: rgba(255,255,255,0.7);
    }
    
    .contacts-grid {
      display: grid;
      gap: 1rem;
      padding: 1rem;
    }
    
    .contact-card {
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }
    
    .contact-card:hover {
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transform: translateY(-2px);
    }
    
    .contact-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1rem;
    }
    
    .contact-name {
      font-size: 1.2rem;
      font-weight: bold;
      color: #2c3e50;
      margin: 0;
    }
    
    .contact-date {
      color: #7f8c8d;
      font-size: 0.9rem;
    }
    
    .contact-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin-bottom: 1rem;
    }
    
    .info-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .info-item i {
      color: #3498db;
      width: 16px;
    }
    
    .contact-message {
      background: #f8f9fa;
      padding: 1rem;
      border-radius: 5px;
      border-left: 4px solid #3498db;
      margin-top: 1rem;
    }
    
    .location-info {
      background: #e8f5e8;
      padding: 0.8rem;
      border-radius: 5px;
      margin-top: 1rem;
      font-size: 0.9rem;
    }
    
    .location-info i {
      color: #27ae60;
    }
    
    .no-contacts {
      text-align: center;
      padding: 3rem;
      color: #7f8c8d;
    }
    
    .no-contacts i {
      font-size: 4rem;
      margin-bottom: 1rem;
      opacity: 0.5;
    }
    
    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: #3498db;
      color: white;
      padding: 0.8rem 1.5rem;
      border-radius: 5px;
      text-decoration: none;
      transition: background 0.3s ease;
      margin-bottom: 2rem;
    }
    
    .back-button:hover {
      background: #2980b9;
    }
    
    @media (max-width: 768px) {
      .contacts-container {
        padding: 1rem;
      }
      
      .contact-info {
        grid-template-columns: 1fr;
      }
      
      .table-header {
        flex-direction: column;
        gap: 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="contacts-container">
    <a href="/" class="back-button">
      <i class="fas fa-arrow-left"></i>
      Volver al Inicio
    </a>
    
    <div class="contacts-header">
      <h1><i class="fas fa-address-book"></i> Contactos Registrados</h1>
      <p>Gestión de contactos y consultas recibidas</p>
    </div>
    
    <div class="contacts-stats">
      <div class="stat-card">
        <i class="fas fa-users"></i>
        <h3 id="totalContacts">0</h3>
        <p>Total Contactos</p>
      </div>
      <div class="stat-card">
        <i class="fas fa-calendar-day"></i>
        <h3 id="todayContacts">0</h3>
        <p>Hoy</p>
      </div>
      <div class="stat-card">
        <i class="fas fa-calendar-week"></i>
        <h3 id="weekContacts">0</h3>
        <p>Esta Semana</p>
      </div>
      <div class="stat-card">
        <i class="fas fa-globe"></i>
        <h3 id="uniqueCountries">0</h3>
        <p>Países</p>
      </div>
    </div>
    
    <div class="contacts-table">
      <div class="table-header">
        <h2><i class="fas fa-list"></i> Lista de Contactos</h2>
        <div class="search-box">
          <i class="fas fa-search"></i>
          <input type="text" id="searchInput" placeholder="Buscar contactos...">
        </div>
      </div>
      
      <div class="contacts-grid" id="contactsGrid">
        <div class="no-contacts">
          <i class="fas fa-spinner fa-spin"></i>
          <p>Cargando contactos...</p>
        </div>
      </div>
    </div>
  </div>
  
  <script>
    // Get contacts data from server
    let allContacts = <% if (typeof contacts !== 'undefined' && contacts) { %><%- JSON.stringify(contacts) %><% } else { %>[]<% } %>;
    
    // Load contacts on page load
    document.addEventListener('DOMContentLoaded', function() {
      displayContacts(allContacts);
      updateStats(allContacts);
    });
    
    // Search functionality
    document.getElementById('searchInput').addEventListener('input', function() {
      const searchTerm = this.value.toLowerCase();
      filterContacts(searchTerm);
    });
    
    function loadContacts() {
      // Data is already loaded from server
      displayContacts(allContacts);
      updateStats(allContacts);
    }
    
    function displayContacts(contacts) {
      const grid = document.getElementById('contactsGrid');
      
      if (contacts.length === 0) {
        grid.innerHTML = `
          <div class="no-contacts">
            <i class="fas fa-inbox"></i>
            <p>No hay contactos registrados</p>
          </div>
        `;
        return;
      }
      
      grid.innerHTML = contacts.map(contact => `
        <div class="contact-card">
          <div class="contact-header">
            <h3 class="contact-name">${escapeHtml(contact.nombre)}</h3>
            <span class="contact-date">${formatDate(contact.fecha_creacion)}</span>
          </div>
          
          <div class="contact-info">
            <div class="info-item">
              <i class="fas fa-envelope"></i>
              <span>${escapeHtml(contact.email)}</span>
            </div>
            <div class="info-item">
              <i class="fas fa-phone"></i>
              <span>${escapeHtml(contact.telefono || 'No especificado')}</span>
            </div>
            <div class="info-item">
              <i class="fas fa-user"></i>
              <span>ID: ${contact.id}</span>
            </div>
          </div>
          
          ${contact.mensaje ? `
            <div class="contact-message">
              <strong>Mensaje:</strong><br>
              ${escapeHtml(contact.mensaje).replace(/\n/g, '<br>')}
            </div>
          ` : ''}
          
          ${contact.pais || contact.ciudad ? `
            <div class="location-info">
              <i class="fas fa-map-marker-alt"></i>
              <strong>Ubicación:</strong> 
              ${[contact.ciudad, contact.pais].filter(Boolean).join(', ')}
              ${contact.ip_address ? ` (IP: ${contact.ip_address})` : ''}
            </div>
          ` : ''}
        </div>
      `).join('');
    }
    
    function filterContacts(searchTerm) {
      const filtered = allContacts.filter(contact => 
        contact.nombre.toLowerCase().includes(searchTerm) ||
        contact.email.toLowerCase().includes(searchTerm) ||
        (contact.mensaje && contact.mensaje.toLowerCase().includes(searchTerm)) ||
        (contact.pais && contact.pais.toLowerCase().includes(searchTerm)) ||
        (contact.ciudad && contact.ciudad.toLowerCase().includes(searchTerm)) ||
        (contact.telefono && contact.telefono.toLowerCase().includes(searchTerm))
      );
      
      displayContacts(filtered);
    }
    
    function updateStats(contacts) {
      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const weekAgo = new Date(today.getTime() - 7 * 24 * 60 * 60 * 1000);
      
      const todayContacts = contacts.filter(contact => 
        new Date(contact.fecha_creacion) >= today
      ).length;
      
      const weekContacts = contacts.filter(contact => 
        new Date(contact.fecha_creacion) >= weekAgo
      ).length;
      
      const uniqueCountries = new Set(
        contacts.map(contact => contact.pais).filter(Boolean)
      ).size;
      
      document.getElementById('totalContacts').textContent = contacts.length;
      document.getElementById('todayContacts').textContent = todayContacts;
      document.getElementById('weekContacts').textContent = weekContacts;
      document.getElementById('uniqueCountries').textContent = uniqueCountries;
    }
    
    function formatDate(dateString) {
      const date = new Date(dateString);
      return date.toLocaleDateString('es-ES', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    }
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
    
    function showError(message) {
      const grid = document.getElementById('contactsGrid');
      grid.innerHTML = `
        <div class="no-contacts">
          <i class="fas fa-exclamation-triangle"></i>
          <p>${message}</p>
        </div>
      `;
    }
  </script>

  <!-- Google Analytics -->
  <% if (googleAnalyticsId) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= googleAnalyticsId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= googleAnalyticsId %>');
  </script>
  <% } %>
</body>
</html>
