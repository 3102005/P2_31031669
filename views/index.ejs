          <% if (isAuthenticated) { %>
            <li><a href="/admin" class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium"><%= t('nav.admin') %></a></li>
            <li><a href="/auth/logout" class="text-red-600 hover:text-red-700 transition-colors duration-300 font-medium"><%= t('nav.logout') %></a></li>
          <% } else { %>
            <li><a href="/auth/login" class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium"><%= t('nav.login') %></a></li>
          <% } %>
          <!-- Language Selector -->
          <li class="relative group">
            <button class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium flex items-center space-x-1">
              <i class="fas fa-globe"></i>
              <span><%= currentLanguage === 'es' ? 'ES' : 'EN' %></span>
              <i class="fas fa-chevron-down text-xs"></i>
            </button>
            <div class="absolute right-0 mt-2 w-32 bg-white rounded-md shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
              <a href="/language/change/es" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-t-md">🇪🇸 Español</a>
              <a href="/language/change/en" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 rounded-b-md">🇺🇸 English</a>
            </div>
          </li>
