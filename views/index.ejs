            <a href="/language/change/es" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium">🇪🇸 Español</a>
            <a href="/language/change/en" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium">🇺🇸 English</a>
          </div>
          <a href="#cita" class="block mx-3 my-2 px-4 py-2 bg-gradient-to-r from-vet-primary to-vet-secondary text-white rounded-lg hover:shadow-lg transition-all duration-300 font-medium text-center"><%= t('nav.schedule') %></a>
        </div>
