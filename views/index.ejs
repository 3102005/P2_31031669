        </ul>
        <div class="md:hidden flex flex-col space-y-1 cursor-pointer" id="hamburger">
          <span class="w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
          <span class="w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
          <span class="w-6 h-0.5 bg-gray-700 transition-all duration-300"></span>
        </div>
      </div>
      <!-- Mobile Menu -->
      <div class="md:hidden hidden bg-white border-t border-gray-200" id="mobile-menu">
        <div class="px-4 py-2 space-y-1">
          <a href="#inicio" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.home') %></a>
          <a href="#servicios" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.services') %></a>
          <a href="#galeria" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.gallery') %></a>
          <a href="#nosotros" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.about') %></a>
          <% if (isAuthenticated) { %>
            <a href="/admin" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.admin') %></a>
            <a href="/auth/logout" class="block px-3 py-2 text-red-600 hover:text-red-700 hover:bg-red-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.logout') %></a>
          <% } else { %>
            <a href="/auth/login" class="block px-3 py-2 text-gray-700 hover:text-vet-primary hover:bg-gray-50 rounded-md transition-colors duration-300 font-medium"><%= t('nav.login') %></a>
