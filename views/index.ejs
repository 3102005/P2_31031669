            <span><%= t('services.requestService') %></span>
          </button>
        </div>
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border border-gray-100 group hover:-translate-y-2">
          <div class="bg-gradient-to-br from-green-500 to-emerald-600 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-syringe text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4"><%= t('services.vaccination.name') %></h3>
