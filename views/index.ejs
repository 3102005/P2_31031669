        <ul class="hidden md:flex space-x-8">
          <li><a href="#inicio" class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium"><%= t('nav.home') %></a></li>
          <li><a href="#servicios" class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium"><%= t('nav.services') %></a></li>
          <li><a href="#galeria" class="text-gray-700 hover:text-vet-primary transition-colors duration-300 font-medium"><%= t('nav.gallery') %></a></li>
