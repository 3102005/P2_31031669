          <button class="w-full bg-gradient-to-r from-green-500 to-emerald-600 text-white py-3 px-6 rounded-xl font-semibold hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2" onclick="openPaymentModal('<%= t('services.vaccination.name') %>', <% if (currentLanguage === 'es') { %>900<% } else { %>9<% } %>)">
            <i class="fas fa-calendar-check"></i>
            <span><%= t('services.requestService') %></span>
          </button>
        </div>
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border border-gray-100 group hover:-translate-y-2">
          <div class="bg-gradient-to-br from-pink-500 to-rose-600 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-cut text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4"><%= t('services.grooming.name') %></h3>
          <p class="text-gray-600 mb-6"><%= t('services.grooming.description') %></p>
          <div class="text-2xl font-bold text-pink-600 mb-6"><%= t('services.grooming.price') %> <% if (currentLanguage === 'es') { %>VES 1.200,00 Bs<% } else { %>USD $12.00<% } %></div>
          <button class="w-full bg-gradient-to-r from-pink-500 to-rose-600 text-white py-3 px-6 rounded-xl font-semibold hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2" onclick="openPaymentModal('<%= t('services.grooming.name') %>', <% if (currentLanguage === 'es') { %>1200<% } else { %>12<% } %>)">
            <i class="fas fa-calendar-check"></i>
            <span><%= t('services.requestService') %></span>
          </button>
        </div>
        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transition-all duration-300 p-8 border border-gray-100 group hover:-translate-y-2">
          <div class="bg-gradient-to-br from-orange-500 to-amber-600 w-16 h-16 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
            <i class="fas fa-pills text-white text-2xl"></i>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-4"><%= t('services.treatments.name') %></h3>
          <p class="text-gray-600 mb-6"><%= t('services.treatments.description') %></p>
          <div class="text-2xl font-bold text-orange-600 mb-6"><%= t('services.treatments.price') %> <% if (currentLanguage === 'es') { %>VES 1.800,00 Bs<% } else { %>USD $18.00<% } %></div>
          <button class="w-full bg-gradient-to-r from-orange-500 to-amber-600 text-white py-3 px-6 rounded-xl font-semibold hover:shadow-lg transform hover:-translate-y-1 transition-all duration-300 flex items-center justify-center space-x-2" onclick="openPaymentModal('<%= t('services.treatments.name') %>', <% if (currentLanguage === 'es') { %>1800<% } else { %>18<% } %>)">
            <i class="fas fa-calendar-check"></i>
            <span><%= t('services.requestService') %></span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Payment Modal -->
  <div id="paymentModal" class="fixed inset-0 z-50 flex items-center justify-center p-4" style="display: none;">
    <div class="absolute inset-0 bg-black bg-opacity-70 backdrop-blur-sm" onclick="closePaymentModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl max-w-md w-full max-h-[90vh] overflow-y-auto transform transition-all duration-300">
      <div class="bg-gradient-to-r from-vet-primary to-vet-secondary text-white p-6 rounded-t-2xl">
        <div class="flex justify-between items-center">
          <h3 class="text-xl font-bold flex items-center space-x-2">
            <i class="fas fa-credit-card"></i>
            <span><%= t('payment.processPayment') %></span>
          </h3>
          <button class="text-white hover:bg-white hover:bg-opacity-20 p-2 rounded-full transition-all duration-300" onclick="closePaymentModal()">
            <i class="fas fa-times text-lg"></i>
          </button>
        </div>
      </div>
      <div class="p-6">
        <div class="bg-gradient-to-r from-vet-accent to-vet-pink text-white p-4 rounded-xl mb-6 text-center">
          <h4 id="modalServiceName" class="text-lg font-semibold mb-2"><%= t('payment.selectedService') %></h4>
          <p class="text-lg"><%= t('payment.amount') %>: <span id="modalServiceAmount" class="font-bold">$0</span></p>
        </div>
        
        <!-- Test Data Button -->
        <div class="mb-4">
          <button type="button" id="fillTestDataBtn" class="w-full bg-gradient-to-r from-blue-500 to-indigo-600 text-white py-2 px-4 rounded-lg hover:shadow-lg transition-all duration-300 font-medium flex items-center justify-center space-x-2">
            <i class="fas fa-flask"></i>
            <span><%= t('modal.fillTestData') %></span>
          </button>
          <div id="testDataInfo" class="mt-2 p-3 bg-blue-50 rounded-lg text-sm text-blue-800" style="display: none;">
            <p class="font-semibold mb-2">Tarjetas de Prueba Disponibles:</p>
            <ul class="space-y-1 text-xs">
              <li><strong>Visa:</strong> 4111111111111111</li>
              <li><strong>Mastercard:</strong> 5555555555554444</li>
              <li><strong>American Express:</strong> 378282246310005</li>
              <li><strong>Discover:</strong> 6011111111111117</li>
              <li><strong>JCB:</strong> 3530111333300000</li>
              <li><strong>Diners Club:</strong> 30569309025904</li>
            </ul>
          </div>
        </div>
        
        <form id="modalPaymentForm" class="space-y-4">
          <input type="hidden" id="modalService" name="service">
          <input type="hidden" id="modalAmount" name="amount">
          
          <div>
            <label for="modalCurrency" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.currency') %></label>
            <select id="modalCurrency" name="currency" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
              <option value="USD">USD - Dólar Estadounidense</option>
              <option value="EUR">EUR - Euro</option>
              <option value="VES">VES - Bolívar Venezolano</option>
            </select>
            <span class="text-red-500 text-sm mt-1 hidden"></span>
          </div>
          
          <div>
            <label for="modalEmail" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.email') %></label>
            <input type="email" id="modalEmail" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
            <span class="text-red-500 text-sm mt-1 hidden"></span>
          </div>
          
          <div>
            <label for="modalCardHolderName" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.cardHolderName') %></label>
            <input type="text" id="modalCardHolderName" name="cardHolderName" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
            <span class="text-red-500 text-sm mt-1 hidden"></span>
          </div>
          
          <div>
            <label for="modalCardNumber" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.cardNumber') %></label>
            <input type="text" id="modalCardNumber" name="cardNumber" placeholder="<%= t('modal.cardNumberPlaceholder') %>" maxlength="19" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
            <span class="text-red-500 text-sm mt-1 hidden"></span>
          </div>
          
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label for="modalExpirationMonth" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.expirationMonth') %></label>
              <select id="modalExpirationMonth" name="expirationMonth" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
                <option value="">Mes</option>
                <option value="01">01</option>
                <option value="02">02</option>
                <option value="03">03</option>
                <option value="04">04</option>
                <option value="05">05</option>
                <option value="06">06</option>
                <option value="07">07</option>
                <option value="08">08</option>
                <option value="09">09</option>
                <option value="10">10</option>
                <option value="11">11</option>
                <option value="12">12</option>
              </select>
              <span class="text-red-500 text-sm mt-1 hidden"></span>
            </div>
            <div>
              <label for="modalExpirationYear" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.expirationYear') %></label>
              <select id="modalExpirationYear" name="expirationYear" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
                <option value="">Año</option>
              </select>
              <span class="text-red-500 text-sm mt-1 hidden"></span>
            </div>
            <div>
              <label for="modalCvv" class="block text-sm font-medium text-gray-700 mb-2"><%= t('modal.cvv') %></label>
              <input type="text" id="modalCvv" name="cvv" placeholder="<%= t('modal.cvvPlaceholder') %>" maxlength="4" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-vet-primary focus:border-transparent transition-all duration-300">
              <span class="text-red-500 text-sm mt-1 hidden"></span>
            </div>
          </div>
          
          <div class="bg-gray-50 p-4 rounded-lg flex items-center space-x-3">
            <div class="bg-green-100 p-2 rounded-lg">
              <i class="fas fa-shield-alt text-green-600"></i>
            </div>
            <span class="text-sm text-gray-600"><%= t('payment.sslProtection') %></span>
          </div>
          
          <div class="flex space-x-4 pt-4">
            <button type="button" class="flex-1 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-all duration-300 font-medium" onclick="closePaymentModal()">
              <%= t('modal.cancel') %>
            </button>
            <button type="submit" class="flex-1 bg-gradient-to-r from-vet-primary to-vet-secondary text-white px-6 py-3 rounded-lg hover:shadow-lg transition-all duration-300 font-medium" id="modalPaymentSubmitBtn">
              <span class="flex items-center justify-center space-x-2">
                <i class="fas fa-credit-card"></i>
                <span><%= t('modal.processPayment') %></span>
              </span>
              <div class="hidden items-center justify-center">
                <i class="fas fa-spinner fa-spin"></i>
              </div>
            </button>
          </div>
        </form>
        
        <div id="modalPaymentResponse" class="mt-4" style="display: none;"></div>
      </div>
    </div>
  </div>

